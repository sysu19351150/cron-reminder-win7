{
  "name": "win7-tiny-reminder",
  "version": "1.0.0",
  "main": "server.js",
  "bin": "server.js",
  "dependencies": {
    "jquery": "^4.1.0",
    "jquery-cron": "^1.0.0",
    "lodash": "^4.17.21",
    "node-cron": "^3.0.2",
    "node-notifier": "^10.0.1"
  },
  "devDependencies": {
    "pkg": "^5.8.1",
    "jest": "^29.7.0"
  },
  "scripts": {
    "start": "node server.js",
    "build": "pkg . --targets node16-win-x64 --output dist/reminder-server.exe",
    "test": "jest",
    "test:config": "node test-config.js",
    "test:config:exe": "node test-config.js --exe dist/reminder-server.exe",
    "test:preview": "node test-cron-preview.js"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "assets/**/*",
      "node_modules/node-notifier/vendor/notifu/**/*"
    ],
    "scripts": [
      "server.js"
    ]
  }
}
